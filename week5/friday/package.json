{
  "name": "kijanikiosk-payments",
  "version": "1.0.0",
  "description": "KijaniKiosk payments service CI project",
  "main": "index.js",
  "files": [
    "dist/**",
    "index.js"
  ],
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "build": "rm -rf dist && mkdir -p dist && cp index.js dist/index.js && cp package.json dist/package.json",
    "test": "jest --ci --reporters=default --reporters=jest-junit",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1117.0",
    "express": "4.22.2"
  },
  "devDependencies": {
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "jest-junit": "16.0.0",
    "supertest": "7.1.3"
  },
  "jest-junit": {
    "outputDirectory": "test-results",
    "outputName": "junit.xml"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
